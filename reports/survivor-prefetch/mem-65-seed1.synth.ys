read_verilog -sv rtl/viterbi_k7_16acs.sv rtl/viterbi_k7_32acs.sv experiments/rs_syndrome_constants.sv rtl/psram_ctrl.sv rtl/benchmark_top.sv
chparam -set WITH_MEM 1 -set WITH_VITERBI 1 -set WITH_RS 1 -set VITERBI_ACS 32 benchmark_top
